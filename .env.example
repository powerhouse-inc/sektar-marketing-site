# Copy to .env.local. Every NEXT_PUBLIC_* value ships to the browser and is
# inlined at build time: rebuild after changing one. The defaults are production.

# The public origin, for metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://sektar.io

# --- Renown sign-in -----------------------------------------------------------

# The site's Renown name. It also namespaces Renown's storage in the browser:
# changing it signs every visitor out.
NEXT_PUBLIC_RENOWN_APP_NAME=sektar-site

# redirect: "Continue with Renown" goes to the Renown portal and back. The site
# is built for this mode; the bundle check keeps wallet libraries out of it.
NEXT_PUBLIC_RENOWN_LOGIN_MODE=redirect

# The Renown portal, and Renown's own switchboard (issues, serves and verifies
# the sign-in credentials).
NEXT_PUBLIC_RENOWN_URL=https://www.renown.id
NEXT_PUBLIC_RENOWN_SWITCHBOARD_URL=https://switchboard.renown.vetra.io/graphql
NEXT_PUBLIC_RENOWN_CHAIN_ID=1

# --- Where a person's Sektar runs -----------------------------------------------

# A home computer published through Portle; {zone} is the person's zone.
NEXT_PUBLIC_PORTLE_URL_TEMPLATE=https://app.{zone}/

# A Sektar cloud environment typed by name: {name} is its Vetra subdomain. A
# Sektar host is its environment's only service, served at the apex.
NEXT_PUBLIC_CLOUD_URL_TEMPLATE=https://{name}.vetra.io/

# Vetra's directory of the signed-in person's Sektar environments (asked with
# their Renown bearer). Empty: the dialog offers remembered and typed addresses only.
NEXT_PUBLIC_DIRECTORY_URL=https://switchboard.vetra.io/api/@powerhousedao/vetra-cloud-package/apps/directory
# Sektar's App on Vetra: the directory lists the environments that run it.
NEXT_PUBLIC_DIRECTORY_APP=43622402-be06-435a-bbfa-bb649b0d6244

# --- The three ways to start -------------------------------------------------

# "Free": Sektar in the browser (documents stay in the visitor's browser).
NEXT_PUBLIC_FREE_URL=https://calm-bat-b4qzzqbb-connect.vetra.io/
# "On your own computer": the desktop app's installers.
NEXT_PUBLIC_DOWNLOAD_URL=https://github.com/powerhouse-inc/sektar/releases/latest
# "In the cloud": invite codes are redeemed on Vetra for the person's own Sektar.
NEXT_PUBLIC_VETRA_GRAPHQL_URL=https://switchboard.vetra.io/graphql

# --- Google sign-in for Sektar cloud environments (server only) ---------------

# The publisher's Google web client (`sektar-google`). The secret stays on this
# site: environments sign in through /api/oauth/callback and redeem codes and
# refresh tokens at /api/oauth/token. Source: OpenBao
# kv/powerhouse/shared/sektar-google-oauth. Unset: the token endpoint answers 503.
SEKTAR_GOOGLE_CLIENT_ID=
SEKTAR_GOOGLE_CLIENT_SECRET=
# Hosts under these domains are relayed to without asking Vetra (comma list).
OAUTH_RELAY_HOST_SUFFIXES=vetra.io
# Vetra's lookup for other hosts (custom domains); empty: suffixes only.
OAUTH_RELAY_LOOKUP_URL=https://switchboard.vetra.io/graphql
