# Copy to .env.local. Every NEXT_PUBLIC_* value ships to the browser and is
# inlined at build time: rebuild after changing one.

# --- Data -------------------------------------------------------------------

# The switchboard your documents live on. `pnpm switchboard` starts one here.
NEXT_PUBLIC_SWITCHBOARD_URL=http://localhost:4001/graphql

# Codegen only (`pnpm codegen`): the switchboard to introspect custom subgraphs on.
PH_SWITCHBOARD_URL=http://localhost:4001/graphql

# --- Renown sign-in ---------------------------------------------------------

# redirect (default): send the user to the Renown portal and back. Needs no
#   wallet configuration, and the build carries no wallet library.
# embedded: sign in in-page with the wallet adapters below.
NEXT_PUBLIC_RENOWN_LOGIN_MODE=redirect

# Your app's Renown name. It also namespaces Renown's localStorage keys:
# changing it signs every user out.
NEXT_PUBLIC_RENOWN_APP_NAME=fusion-app

# The Renown portal (redirect mode) and Renown's own switchboard, which issues,
# serves and verifies credentials. Not your data switchboard.
NEXT_PUBLIC_RENOWN_URL=https://www.renown.id
NEXT_PUBLIC_RENOWN_SWITCHBOARD_URL=https://switchboard.renown.vetra.io/graphql

# Chain the credentials are issued on; part of the user's DID.
NEXT_PUBLIC_RENOWN_CHAIN_ID=1

# --- Embedded mode only -----------------------------------------------------

# Privy (email / Google). Left out entirely when the app id is unset.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Rainbow (browser wallets). Both optional: without the WalletConnect id only an
# installed wallet can sign in; without Infura each chain uses its public RPC.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_INFURA_PROJECT_ID=

# 1 = headless mock signer for local dev and e2e. It signs with a well-known
# key; a production build with it set fails.
NEXT_PUBLIC_RENOWN_MOCK=
